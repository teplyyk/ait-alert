
from flask import Flask, render_template_string
import folium
import requests
import random

app = Flask(__name__)

GEOJSON_URL = (
    "https://raw.githubusercontent.com/"
    "darmat1/ukraine-geo-data/main/geodata/Ukraine.geojson"
)

HTML_TEMPLATE = """
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Карта України</title>

    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            background: #000000 !important;
            font-family: Arial, sans-serif;
        }

        .map-container {
            width: 100%;
            height: 100vh;
            background: #000000;
            overflow: hidden;
        }

        .map-container iframe {
            width: 100%;
            height: 100%;
            border: none;
            display: block;
        }
    </style>
</head>

<body>
    <div class="map-container">
        {{ map_html | safe }}
    </div>
</body>
</html>
"""


@app.route("/")
def index():

    response = requests.get(GEOJSON_URL, timeout=30)
    response.raise_for_status()

    geojson_data = response.json()

    features = geojson_data.get("features", [])

    if not features:
        raise ValueError("GeoJSON не містить областей!")

    print("Успішно завантажено областей:", len(features))

    ukraine_map = folium.Map(
        location=[48.5, 31.2],
        zoom_start=5,
        tiles=None,
        width="100%",
        height="100%",
        min_zoom=4,
        max_zoom=7,
        scrollWheelZoom=False,
        control_scale=False
    )

    # Палітра кольорів
    colors = [
        '#3388ff',
        '#33a02c',
        '#ff7f00',
        '#6a3d9a',
        '#e31a1c',
        '#b15928',
        '#1f78b4',
        '#a6cee3',
        '#fb9a99',
        '#b2df8a'
    ]

    color_by_name = {}

    for i, feature in enumerate(features):
        name = feature["properties"].get(
            "name", f"Область {i + 1}"
        )
        color_by_name[name] = colors[i % len(colors)]

    def style_function(feature):
        name = feature["properties"].get("name", "")

        return {
            "fillColor": color_by_name.get(name, "#3388ff"),
            "color": "#111111",
            "weight": 2,
            "fillOpacity": 0.9
        }

    def highlight_function(feature):
        return {
            "fillColor": "#ffff00",
            "color": "#ffffff",
            "weight": 3,
            "fillOpacity": 1
        }

    geojson_layer = folium.GeoJson(
        geojson_data,
        name="Області України",
        style_function=style_function,
        highlight_function=highlight_function,
        tooltip=folium.GeoJsonTooltip(
            fields=["name"],
            aliases=["Область:"]
        )
    )

    geojson_layer.add_to(ukraine_map)

    bounds = geojson_layer.get_bounds()

    print("Межі карти:", bounds)

    ukraine_map.fit_bounds(
        bounds,
        padding=(40, 40),
        max_zoom=6
    )

    ukraine_map.options["maxZoom"] = 7
    ukraine_map.options["minZoom"] = 4
    ukraine_map.options["scrollWheelZoom"] = False

    map_html = ukraine_map._repr_html_()

    return render_template_string(
        HTML_TEMPLATE,
        map_html=map_html
    )


if __name__ == "__main__":
    app.run(debug=True)

