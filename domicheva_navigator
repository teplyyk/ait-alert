NAME_KEYS = [
    "name", "NAME", "Name",
    "name_uk", "name_ua", "NAME_UA",
    "ADM2_UA", "ADM2_EN",
    "ADM1_UA", "ADM1_EN",
    "shapeName", "rayon", "raion",
    "district", "region",
    "NAME_2", "NAME_1"
]

KYIV_NAMES = {
    "київ",
    "м. київ",
    "м.київ",
    "місто київ",
    "kyiv",
    "kiev",
    "kyiv city",
    "kiev city",
    "city of kyiv",
    "city of kiev"
}


def load(url):
    """Завантажує GeoJSON та кешує його."""

    if url not in _cache:
        response = requests.get(url, timeout=90)
        response.raise_for_status()
        _cache[url] = response.json()

    return _cache[url]


def pick_name(properties, fallback):
    """Шукає назву географічного об'єкта."""

    for key in NAME_KEYS:
        value = properties.get(key)

        if isinstance(value, str) and value.strip():
            return value.strip()

    for value in properties.values():
        if isinstance(value, str) and value.strip():
            return value.strip()

    return fallback


def add_labels(data, prefix):
    """Додає назви об'єктам GeoJSON."""

    for i, feature in enumerate(data.get("features", [])):
        properties = feature.setdefault("properties", {})

        properties["label"] = pick_name(
            properties,
            f"{prefix} {i + 1}"
        )

    return data


def bbox_area(feature):

    xs = []
    ys = []

    def walk(coords):
        if not coords:
            return

        if isinstance(coords[0], (int, float)):
            xs.append(coords[0])
            ys.append(coords[1])
        else:
            for item in coords:
                walk(item)

    geometry = feature.get("geometry") or {}
    walk(geometry.get("coordinates", []))

    if not xs or not ys:
        return float("inf")

    return (
        (max(xs) - min(xs)) *
        (max(ys) - min(ys))
    )


def find_kyiv_city(*datasets):
    """Шукає місто Київ, а не Київську область."""

    for data in datasets:
        matches = []

        for feature in data.get("features", []):
            properties = feature.get("properties", {})

            values = [
                value.strip().lower()
                for value in properties.values()
                if isinstance(value, str)
            ]

            if any(value in KYIV_NAMES for value in values):
                matches.append(feature)

        if matches:
            return min(matches, key=bbox_area)

    return None


def add_shelters(map_object, shelters_data):
    """Додає укриття Києва на карту."""

    cluster = MarkerCluster(
        name="Укриття Києва",
        options={
            "chunkedLoading": True,
            "maxClusterRadius": 50
        }
    )

    valid_shelters = []

    for feature in shelters_data.get("features", []):

        geometry = feature.get("geometry") or {}

        if geometry.get("type") != "Point":
            continue

        coordinates = geometry.get("coordinates", [])

        if len(coordinates) < 2:
            continue

        # GeoJSON: [довгота, широта]

        lon, lat = coordinates[0], coordinates[1]

        if not isinstance(lat, (int, float)):
            continue

        if not isinstance(lon, (int, float)):
            continue

        if not math.isfinite(lat) or not math.isfinite(lon):
            continue

        # Поки використовуємо набір даних Києва

        if not (50.1 <= lat <= 50.7 and 30.2 <= lon <= 30.9):
            continue

        properties = feature.get("properties") or {}

        address = str(
            properties.get("address") or "Адреса не вказана"
        )

        district = str(
            properties.get("district") or "Район не вказаний"
        )

        working_time = str(
            properties.get("working_time") or "Не вказано"
        )

        popup_html = f"""
        <div style="font-family:Arial; min-width:180px;">
            <b>Укриття</b>
            <hr>
            <b>Адреса:</b> {html.escape(address)}<br>
            <b>Район:</b> {html.escape(district)}<br>
            <b>Графік роботи:</b> {html.escape(working_time)}
        </div>
        """

        folium.Marker(
            location=[lat, lon],
            popup=folium.Popup(popup_html, max_width=300),
            tooltip="Укриття: " + address,
            icon=folium.Icon(
                color="green",
                icon="home",
                prefix="fa"
            )
        ).add_to(cluster)

        valid_shelters.append({
            "lat": lat,
            "lon": lon,
            "address": address,
            "district": district
        })

    cluster.add_to(map_object)

    print("Укриттів додано на карту:", len(valid_shelters))

    return valid_shelters

class GeolocationControl(MacroElement):

    def __init__(self, shelters):
        super().__init__()

        self._name = "GeolocationControl"
        self.shelters = shelters

        self._template = Template("""
        {% macro script(this, kwargs) %}

        var map = {{ this._parent.get_name() }};
        var shelters = {{ this.shelters | tojson }};

        var userMarker = null;
        var nearestLayer = L.layerGroup().addTo(map);
        var routeLayer = L.layerGroup().addTo(map);

        // Топографічна підкладка.
        // Спочатку НЕ додаємо її на карту.

        var topoLayer = L.tileLayer(
            "https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png",
            {
                maxZoom: 17,
                attribution:
                    '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors | ' +
                    '<a href="https://opentopomap.org">OpenTopoMap</a>'
            }
        );

        var control = L.control({
            position: "topright"
        });


        function distance(lat1, lon1, lat2, lon2) {

            var R = 6371;

            var dLat = (lat2 - lat1) * Math.PI / 180;
            var dLon = (lon2 - lon1) * Math.PI / 180;

            var a =
                Math.sin(dLat / 2) ** 2 +
                Math.cos(lat1 * Math.PI / 180) *
                Math.cos(lat2 * Math.PI / 180) *
                Math.sin(dLon / 2) ** 2;

            return 2 * R * Math.atan2(
                Math.sqrt(a),
                Math.sqrt(1 - a)
            );
        }

        function decodePolyline(encoded) {

            var points = [];
            var index = 0;
            var lat = 0;
            var lon = 0;

            while (index < encoded.length) {

                var result = 0;
                var shift = 0;
                var b;

                do {
                    b = encoded.charCodeAt(index++) - 63;
                    result |= (b & 0x1f) << shift;
                    shift += 5;
                } while (b >= 0x20);

                var deltaLat =
                    (result & 1) ? ~(result >> 1) : (result >> 1);

                lat += deltaLat;

                result = 0;
                shift = 0;

                do {
                    b = encoded.charCodeAt(index++) - 63;
                    result |= (b & 0x1f) << shift;
                    shift += 5;
                } while (b >= 0x20);

                var deltaLon =
                    (result & 1) ? ~(result >> 1) : (result >> 1);

                lon += deltaLon;

                points.push([
                    lat / 1000000,
                    lon / 1000000
                ]);
            }

            return points;
        }

        async function buildRoute(userLat, userLon, shelter) {

            var result = document.getElementById("geo-result");
            var routeButton = document.getElementById("route-button");

            routeButton.disabled = true;
            routeButton.innerHTML = "Прокладаємо маршрут...";

            try {

                var requestData = {
                    locations: [
                        {
                            lat: userLat,
                            lon: userLon,
                            type: "break"
                        },
                        {
                            lat: shelter.lat,
                            lon: shelter.lon,
                            type: "break"
                        }
                    ],

                    costing: "pedestrian",
                    units: "kilometers",
                    language: "uk",
                    shape_format: "polyline6"
                };

                var response = await fetch(
                    "https://valhalla1.openstreetmap.de/route",
                    {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify(requestData)
                    }
                );

                if (!response.ok) {
                    throw new Error(
                        "Сервіс маршрутизації повернув помилку: " +
                        response.status
                    );
                }

                var data = await response.json();

                if (
                    !data.trip ||
                    !data.trip.legs ||
                    !data.trip.legs.length
                ) {
                    throw new Error("Маршрут не знайдено.");
                }

                var leg = data.trip.legs[0];

                if (!leg.shape) {
                    throw new Error("Сервіс не повернув лінію маршруту.");
                }

                var points = decodePolyline(leg.shape);

                if (!points.length) {
                    throw new Error("Не вдалося побудувати лінію маршруту.");
                }

                routeLayer.clearLayers();

                if (!map.hasLayer(topoLayer)) {
                    topoLayer.addTo(map);
                }

                // Малюємо маршрут

                var routeLine = L.polyline(
                    points,
                    {
                        color: "#168cff",
                        weight: 6,
                        opacity: 0.95,
                        lineCap: "round",
                        lineJoin: "round"
                    }
                ).addTo(routeLayer);

                // Маркер пункту призначення

                L.marker(
                    [shelter.lat, shelter.lon],
                    {
                        icon: L.icon({
                            iconUrl:
                                "https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-icon.png",
                            iconRetinaUrl:
                                "https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-icon-2x.png",
                            shadowUrl:
                                "https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-shadow.png",
                            iconSize: [25, 41],
                            iconAnchor: [12, 41]
                        })
                    }
                )
                .addTo(routeLayer)
                .bindPopup(
                    "<b>Обране укриття</b><br>" +
                    shelter.address
                );

                // Початкова точка

                L.circleMarker(
                    [userLat, userLon],
                    {
                        radius: 8,
                        color: "#ffffff",
                        weight: 2,
                        fillColor: "#168cff",
                        fillOpacity: 1
                    }
                )
                .addTo(routeLayer)
                .bindPopup("Ваше місцезнаходження");

                // Відстань та час

                var summary = data.trip.summary;

                var km = summary.length;
                var minutes = Math.round(summary.time / 60);

                map.fitBounds(routeLine.getBounds(), {
                    padding: [50, 50]
                });

                result.innerHTML =
                    "<b>Пішохідний маршрут побудовано</b>" +
                    "<div class='route-info'>" +
                    "<b>Укриття:</b> " + shelter.address + "<br>" +
                    "<b>Відстань:</b> " + km.toFixed(2) + " км<br>" +
                    "<b>Орієнтовний час:</b> " + minutes + " хв" +
                    "<br><small>Час є оцінкою сервісу, а не гарантією безпечного прибуття.</small>" +
                    "</div>";

                routeButton.innerHTML = "Маршрут побудовано";

                // Кнопка скасування

                var cancelButton = document.createElement("button");

                cancelButton.className =
                    "geo-button cancel-route";

                cancelButton.innerHTML = "Повернути чорну карту";

                cancelButton.onclick = function() {

                    routeLayer.clearLayers();

                    if (map.hasLayer(topoLayer)) {
                        map.removeLayer(topoLayer);
                    }

                    map.setView([50.4501, 30.5234], 6);

                    result.innerHTML =
                        "Маршрут скасовано. Можна вибрати інше укриття.";

                    routeButton.disabled = false;
                    routeButton.innerHTML = "Прокласти маршрут";
                };

                result.appendChild(cancelButton);

            } catch (error) {

                console.error("Помилка маршруту:", error);

                result.innerHTML =
                    "<b>Не вдалося прокласти маршрут.</b><br>" +
                    "Можливо, сервіс тимчасово недоступний. " +
                    "Спробуй ще раз пізніше.";

                routeButton.disabled = false;
                routeButton.innerHTML = "Спробувати ще раз";
            }
        }


        control.onAdd = function() {

            var container = L.DomUtil.create(
                "div",
                "geo-control"
            );

            var button = L.DomUtil.create(
                "button",
                "geo-button",
                container
            );

            button.type = "button";
            button.innerHTML = "Знайти найближчі укриття";

            var result = L.DomUtil.create(
                "div",
                "geo-result",
                container
            );

            result.id = "geo-result";
            result.style.display = "none";

            L.DomEvent.disableClickPropagation(container);
            L.DomEvent.disableScrollPropagation(container);

            button.onclick = function() {

                if (!navigator.geolocation) {

                    result.style.display = "block";
                    result.innerHTML =
                        "Браузер не підтримує геолокацію.";

                    return;
                }

                button.disabled = true;
                button.innerHTML = "Визначаємо місцезнаходження...";

                navigator.geolocation.getCurrentPosition(

                    function(position) {

                        var userLat = position.coords.latitude;
                        var userLon = position.coords.longitude;

                        var userLocation = [userLat, userLon];

                        nearestLayer.clearLayers();
                        routeLayer.clearLayers();

                        if (map.hasLayer(topoLayer)) {
                            map.removeLayer(topoLayer);
                        }

                        if (userMarker) {
                            map.removeLayer(userMarker);
                        }

                        userMarker = L.marker(userLocation)
                            .addTo(map)
                            .bindPopup("Ваше місцезнаходження");

                        userMarker.openPopup();

                        map.setView(userLocation, 15);

                        // Знаходимо три найближчі укриття

                        var nearest = shelters.map(function(shelter) {

                            return {
                                shelter: shelter,

                                distance: distance(
                                    userLat,
                                    userLon,
                                    shelter.lat,
                                    shelter.lon
                                )
                            };

                        });

                        nearest.sort(function(a, b) {
                            return a.distance - b.distance;
                        });

                        nearest = nearest.slice(0, 3);

                        result.style.display = "block";

                        result.innerHTML =
                            "<b>Три найближчі укриття</b><br>" +
                            "<small>Попереднє сортування за відстанню по прямій.</small>";

                        if (nearest.length === 0) {

                            result.innerHTML +=
                                "<br>Укриттів у завантажених даних не знайдено.";
                        }

                        nearest.forEach(function(item, index) {

                            var shelter = item.shelter;

                            var marker = L.circleMarker(
                                [shelter.lat, shelter.lon],
                                {
                                    radius: 8,
                                    color: "#ffffff",
                                    weight: 2,
                                    fillColor: "#00cc66",
                                    fillOpacity: 1
                                }
                            ).addTo(nearestLayer);

                            marker.bindPopup(
                                "<b>Укриття " + (index + 1) + "</b><br>" +
                                shelter.address
                            );

                            var choice = document.createElement("button");

                            choice.className = "shelter-choice";

                            choice.innerHTML =
                                (index + 1) + ". " +
                                shelter.address +
                                "<br><small>" +
                                shelter.district +
                                " · " +
                                item.distance.toFixed(2) +
                                " км по прямій</small>";

                            choice.onclick = function() {

                                result.innerHTML =
                                    "<b>Обране укриття:</b><br>" +
                                    shelter.address +
                                    "<br><br>" +
                                    "<button id='route-button' class='geo-button'>" +
                                    "Прокласти маршрут" +
                                    "</button>";

                                var routeButton =
                                    document.getElementById("route-button");

                                routeButton.onclick = function() {
                                    buildRoute(
                                        userLat,
                                        userLon,
                                        shelter
                                    );
                                };
                            };

                            result.appendChild(choice);
                        });

                        button.disabled = false;
                        button.innerHTML = "Оновити пошук укриттів";
                    },

                    function(error) {

                        var message =
                            "Не вдалося визначити місцезнаходження.";

                        if (error.code === 1) {
                            message =
                                "Ти не надала дозвіл на геолокацію.";
                        } else if (error.code === 2) {
                            message =
                                "Місцезнаходження недоступне.";
                        } else if (error.code === 3) {
                            message =
                                "Час очікування геолокації минув.";
                        }

                        result.style.display = "block";
                        result.innerHTML = message;

                        button.disabled = false;
                        button.innerHTML = "Спробувати ще раз";
                    },

                    {
                        enableHighAccuracy: true,
                        timeout: 15000,
                        maximumAge: 10000
                    }
                );
            };

            return container;
        };

        control.addTo(map);

        {% endmacro %}
        """)



@app.route("/")
def index():

    # Завантаження районів та областей

    raions = add_labels(
        load(RAIONS_URL),
        "Район"
    )

    oblasts = add_labels(
        load(OBLASTS_URL),
        "Область"
    )

    if not raions.get("features"):
        raise ValueError("rayony.geojson не містить районів!")

    print("Районів:", len(raions["features"]))
    print("Областей:", len(oblasts.get("features", [])))



    kyiv = find_kyiv_city(raions, oblasts)

    if kyiv is None:
        try:
            fallback = add_labels(
                load(FALLBACK_URL),
                "Область"
            )

            kyiv = find_kyiv_city(fallback)

        except requests.RequestException as exc:
            print("Запасне джерело недоступне:", exc)

    if kyiv is None:
        print("УВАГА: м. Київ не знайдено!")


    shelters_data = load(SHELTERS_URL)

    print(
        "Отримано об'єктів укриттів:",
        len(shelters_data.get("features", []))
    )


    ukraine_map = folium.Map(
        location=[48.5, 31.2],
        zoom_start=6,
        tiles=None,
        width="100%",
        height="100%",
        min_zoom=5,
        max_zoom=19,
        scrollWheelZoom=True,
        control_scale=False,
        zoomSnap=0.5
    )



    ukraine_map.options["maxZoom"] = 19

    ukraine_map.get_root().header.add_child(
        folium.Element(MAP_CSS)
    )


    folium.GeoJson(
        raions,
        name="Райони",
        style_function=lambda feature: {
            "fillColor": "#1b3a5c",
            "color": "#5d86b3",
            "weight": 0.8,
            "fillOpacity": 0.9
        },
        highlight_function=lambda feature: {
            "fillColor": "#ffff00",
            "color": "#ffffff",
            "weight": 2,
            "fillOpacity": 1
        },
        tooltip=folium.GeoJsonTooltip(
            fields=["label"],
            aliases=["Район:"]
        )
    ).add_to(ukraine_map)

    if kyiv is not None:

        kyiv = dict(kyiv)

        kyiv["properties"] = dict(
            kyiv.get("properties", {}),
            label="м. Київ"
        )

        folium.GeoJson(
            {
                "type": "FeatureCollection",
                "features": [kyiv]
            },
            name="м. Київ",
            style_function=lambda feature: {
                "fillColor": "#2a6f97",
                "color": "#ffffff",
                "weight": 1.5,
                "fillOpacity": 1
            },
            highlight_function=lambda feature: {
                "fillColor": "#ffff00",
                "color": "#ffffff",
                "weight": 2.5,
                "fillOpacity": 1
            },
            tooltip=folium.GeoJsonTooltip(
                fields=["label"],
                aliases=["Місто:"]
            )
        ).add_to(ukraine_map)


    oblast_layer = folium.GeoJson(
        oblasts,
        name="Області",
        style_function=lambda feature: {
            "fill": False,
            "color": "#ffffff",
            "weight": 2
        },
        interactive=False
    )

    oblast_layer.add_to(ukraine_map)


    shelters = add_shelters(
        ukraine_map,
        shelters_data
    )



    geo_control = GeolocationControl(shelters)
    geo_control.add_to(ukraine_map)



    ukraine_map.fit_bounds(
        oblast_layer.get_bounds(),
        padding=(30, 30),
        max_zoom=6
    )

    map_html = ukraine_map._repr_html_()

    return render_template_string(
        HTML_TEMPLATE,
        map_html=map_html
    )


if __name__ == "__main__":
    app.run(debug=True)
